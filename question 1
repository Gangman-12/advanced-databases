-- (f) Index and Justification [5 marks]
CREATE INDEX idx_sales_medicine_sold_on ON sales (medicine_id, sold_on);

EXPLAIN
SELECT sale_id, quantity, unit_price, sold_on
FROM sales
WHERE medicine_id = 1
  AND sold_on BETWEEN '2026-11-20' AND '2026-11-23';

-- Justification: A composite B-tree index on (medicine_id, sold_on) places the equality predicate column (medicine_id) first and the range predicate column (sold_on) second. PostgreSQL locates all records for medicine_id = 1 in a contiguous leaf-node slice and scans only the requested date bounds without scanning the entire sales table.

/* EXPLAIN PLAN OUTPUT:
Index Scan using idx_sales_medicine_sold_on on sales  (cost=0.14..8.16 rows=2 width=24)
  Index Cond: ((medicine_id = 1) AND (sold_on >= '2026-11-20'::date) AND (sold_on <= '2026-11-23'::date))
*/

-- (g) Scheduled Job: pr_refresh_sales [6 marks]
CREATE OR REPLACE PROCEDURE pr_refresh_sales(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_total_qty    INTEGER;
    v_total_amount NUMERIC(12, 2);
BEGIN
    SELECT COALESCE(SUM(quantity), 0),
           COALESCE(SUM(quantity * unit_price), 0.00)
    INTO v_total_qty, v_total_amount
    FROM sales
    WHERE sold_on = p_day;

    INSERT INTO daily_sales (sales_date, total_qty, total_amount)
    VALUES (p_day, v_total_qty, v_total_amount)
    ON CONFLICT (sales_date) DO UPDATE
    SET total_qty    = EXCLUDED.total_qty,
        total_amount = EXCLUDED.total_amount;
END;
$$;

-- Schedule daily execution at 00:15 for the prior day via pg_cron:
SELECT cron.schedule(
    'refresh_daily_pharmacy_sales',
    '15 0 * * *',
    $$CALL pr_refresh_sales((CURRENT_DATE - INTERVAL '1 day')::date);$$
);
